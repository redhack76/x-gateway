#!/bin/sh /etc/rc.common
# /etc/init.d/xgw_agent  (OpenWrt procd)
# procd가 프로세스를 감시/재시작하므로 -f (포그라운드)로 실행한다.

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/xgw_agent -f -c /etc/xgw/xgw_agent.conf
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	restart
}
